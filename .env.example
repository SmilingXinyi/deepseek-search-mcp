# Copy to .env and adjust as needed.
# DEEPSEEK_API_KEY is required. It is read by the process and is not stored in the repo.
DEEPSEEK_API_KEY=
# Optional. Defaults to https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
MCP_HOST=127.0.0.1
MCP_PORT=3000
# MCP_AUTH_TOKEN=secret
MCP_LOG_LEVEL=info
MCP_LOG_DIR=./logs
# MCP_LOG_FILE=0
IMAGE_NAME=deepseek-search-mcp
IMAGE_TAG=latest
